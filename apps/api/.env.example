# ── Online Tech Uganda API — environment example (copy to .env, fill values) ──
# NEVER commit the real .env. Secrets stay server-side only; never in the frontend.

# Database (production = Postgres; local dev can use sqlite:///./dev.db)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/onlinetech

# Admin key required for admin write endpoints
ADMIN_API_KEY=

# Public URLs
SITE_URL=https://www.onlinetechug.com
API_PUBLIC_URL=https://api.onlinetechug.com

# ── Pesapal API 3.0 ──────────────────────────────────────────────────────────
# Start in sandbox, switch to "live" for production.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Optional: a pre-registered IPN id. Leave blank to let the app register one
# automatically against  {API_PUBLIC_URL}/api/v1/payments/pesapal/ipn
PESAPAL_IPN_ID=
# These two are informational for reference; the API derives the actual URLs
# from SITE_URL / API_PUBLIC_URL above.
PESAPAL_CALLBACK_URL=https://www.onlinetechug.com/checkout/success
PESAPAL_CANCELLATION_URL=https://www.onlinetechug.com/checkout

# Email (Gmail SMTP) — used to email order confirmations after verified payment
GMAIL_USER=onlinetechug@gmail.com
GMAIL_APP_PASSWORD=
